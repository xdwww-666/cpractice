{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "编译并运行当前文件",
      "type": "shell",
      "command": "g++ -std=c++17 -Wall -Wextra -g -fsanitize=address,undefined -o '${fileDirname}/${fileBasenameNoExtension}' '${file}' && '${fileDirname}/${fileBasenameNoExtension}'",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "只编译，不运行",
      "type": "shell",
      "command": "g++ -std=c++17 -Wall -Wextra -g -fsanitize=address,undefined -o '${fileDirname}/${fileBasenameNoExtension}' '${file}'",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": false
      },
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}
